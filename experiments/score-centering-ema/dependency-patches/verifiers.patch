+def _slice_sampler_head(payload, length):
+    if payload is None:
+        return None
+    import base64
+    rows, k = payload["shape"]
+    if rows < length:
+        raise ValueError("Sampler head shorter than completion")
+    result = {"shape": [length, k]}
+    for key in ("ids", "logprobs"):
+        raw = base64.b64decode(payload[key], validate=True)
+        if len(raw) != rows * k * 4:
+            raise ValueError("Malformed sampler head")
+        result[key] = base64.b64encode(raw[:length * k * 4]).decode()
+    return result
+
+
