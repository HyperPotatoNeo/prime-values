{
  "output_dir": "/Users/siddarth/Documents/Codex/2026-11-05/so-for-this-i-want-to/work/episode-producer/native-preflight/run",
  "model": {
    "name": "Qwen/Qwen3-4B-Instruct-2507"
  },
  "seq_len": 512,
  "max_steps": 3,
  "log": {
    "level": "debug"
  },
  "ckpt": {
    "interval": 1,
    "keep_last": 1
  },
  "trainer": {
    "model": {
      "impl": "custom",
      "attn": "flash_attention_2",
      "optim_cpu_offload": false
    },
    "optim": {
      "lr": 1e-06
    }
  },
  "inference": {
    "model": {
      "max_model_len": 512,
      "enforce_eager": true
    },
    "gpu_memory_utilization": 0.4,
    "enable_prefix_caching": false
  },
  "orchestrator": {
    "batch_size": 8,
    "group_size": 2,
    "max_inflight_rollouts": 8,
    "algo": {
      "type": "grpo",
      "baseline": {
        "type": "value"
      }
    },
    "train": {
      "sampling": {
        "temperature": 1.0,
        "max_completion_tokens": 64
      },
      "env": [
        {
          "env": {
            "taskset": {
              "id": "reverse-text-v1"
            },
            "agent": {
              "harness": {
                "id": "null",
                "runtime": {
                  "type": "subprocess"
                }
              }
            }
          },
          "pool": {
            "type": "static",
            "num_workers": 1
          }
        }
      ]
    }
  },
  "value_function": {
    "warmup_updates": 2,
    "batch_size": 8,
    "evaluator": {
      "placement": "dedicated",
      "max_batch_tokens": 4096
    },
    "replay": {
      "max_updates_per_rollout": 1
    },
    "ckpt": {
      "interval": 1,
      "keep_last": 1
    }
  },
  "deployment": {
    "type": "single_node",
    "gpus_per_node": 4,
    "num_infer_gpus": 1,
    "num_train_gpus": 1,
    "num_value_train_gpus": 1,
    "num_value_eval_gpus": 1
  }
}
